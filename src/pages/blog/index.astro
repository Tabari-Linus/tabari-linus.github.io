---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', (p) => !p.data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<Base
  title="Blog — Linus Tabari"
  description="Writing on backend engineering, Spring Boot, and distributed systems."
>
  <h1 class="font-[Sora] text-3xl font-bold mb-8">Blog</h1>
  {
    posts.length === 0 ? (
      <p class="text-paper-dim">
        Nothing here yet. Posts are published by opening a GitHub issue labeled{' '}
        <code class="font-mono text-gold">blog</code>.
      </p>
    ) : (
      <ul class="grid gap-6">
        {posts.map((post) => (
          <li class="border-b border-ink-700 pb-6">
            <a href={`/blog/${post.id}/`} class="font-[Sora] text-xl font-semibold hover:text-gold">
              {post.data.title}
            </a>
            <p class="font-mono text-xs text-paper-dim mt-2">
              {post.data.date.toISOString().slice(0, 10)}
              {post.data.tags.length > 0 && <> · {post.data.tags.join(', ')}</>}
            </p>
          </li>
        ))}
      </ul>
    )
  }
</Base>
